<Window x:Class="QuickJot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuickJot"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="QuickJot"
        Width="560"
        MinWidth="360"
        MaxWidth="1200"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="Manual">

    <!-- AllowsTransparency НЕ используется: он убивает аппаратное ускорение и ломает Mica (раздел 5). -->
    <WindowChrome.WindowChrome>
        <!-- Ширина тянется мышью за края; высоту всё равно держит SizeToContent — раздел 5. -->
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
            Слой состояния — раздел 15. Кисти из словаря ресурсов заморожены, и перекрасить их
            анимацией нельзя: ColorAnimation по ним падает в рантайме. Поэтому фон не меняется,
            а поверх базового лежит прозрачный слой и проявляется сам.

            Состояние приходит через Tag: одна разметка обслуживает наведение, выделение,
            подсветку новой задачи и корешок. Tag объявлен как object, поэтому значение условия
            задаётся типизированным литералом — строка «True» с ним не сравнится.
        -->
        <Style x:Key="StateLayer" TargetType="Border">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="CornerRadius" Value="9" />
            <Style.Triggers>
                <!-- Анимации выключены — слой просто включается. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
                            <Condition.Value>
                                <sys:Boolean>True</sys:Boolean>
                            </Condition.Value>
                        </Condition>
                        <Condition Binding="{Binding DataContext.AnimationsOn, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="1" />
                </MultiDataTrigger>

                <!--
                    Кросс-фейд. From намеренно не задан: анимация стартует с текущего значения,
                    поэтому быстрый проход мышью по списку не мигает — слой подхватывается с
                    полпути. Гаснет медленнее, чем зажигается: подсветка новой задачи так успевает
                    «отпустить», а наведение не выглядит липким.
                -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
                            <Condition.Value>
                                <sys:Boolean>True</sys:Boolean>
                            </Condition.Value>
                        </Condition>
                        <Condition Binding="{Binding DataContext.AnimationsOn, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>


        <!--
            Поля без рамки: только каретка и placeholder (раздел 15). Стандартный шаблон Fluent
            рисует свою подложку и акцентное подчёркивание — на Mica это выглядит как дыра в окне.
        -->
        <Style x:Key="PlainTextBox" TargetType="TextBox">
            <!-- Ctrl+Z всегда уходит в стек операций, а не в отмену набора текста — раздел 11. -->
            <Setter Property="IsUndoEnabled" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionOpacity" Value="0.4" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <Grid>
                                <!--
                                    Padding отдан только тексту: WPF применяет его внутри поля сам,
                                    и если продублировать его на рамке, текст уезжает вправо вдвое.
                                    Placeholder получает тот же отступ и потому стоит ровно под кареткой.
                                -->
                                <TextBlock x:Name="Placeholder"
                                           Margin="{TemplateBinding Padding}"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />

                                <!-- Style={x:Null}: у ScrollViewer в теме Fluent свой отступ под жёлоб
                                     полосы прокрутки, из-за него текст начинался правее placeholder. -->
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Style="{x:Null}"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              Padding="0"
                                              Margin="0"
                                              HorizontalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Раскрытие блока — раздел 15. Высоту к Auto анимировать нечем, поэтому сжимается
            LayoutTransform, как у уходящих строк: сжаться должна именно разметка, иначе блок
            освободит место рывком. Элементу нужен свой ScaleTransform прямо в разметке —
            общий из стиля был бы заморожен, и анимация по нему упала бы.

            Показывает сеттер, а не анимация: код сразу после раскрытия ставит каретку в поле,
            а фокус в невидимый элемент не встаёт. Прячет наоборот анимация — иначе блок исчезал
            бы, не успев схлопнуться. FillBehavior="Stop" возвращает значения базовым, поэтому
            следующее раскрытие начинается с чистого листа.
        -->
        <Style x:Key="Reveal" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
                    <DataTrigger.Value>
                        <sys:Boolean>True</sys:Boolean>
                    </DataTrigger.Value>
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
                            <Condition.Value>
                                <sys:Boolean>True</sys:Boolean>
                            </Condition.Value>
                        </Condition>
                        <Condition Binding="{Binding DataContext.AnimationsOn, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleY)"
                                                 From="0" To="1" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.16" Value="{x:Static Visibility.Collapsed}" />
                                </ObjectAnimationUsingKeyFrames>
                                <DoubleAnimation Storyboard.TargetProperty="(FrameworkElement.LayoutTransform).(ScaleTransform.ScaleY)"
                                                 To="0" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseIn" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Заметка: вложенная поверхность, а не светлая коробка поверх тёмного окна. -->
        <Style x:Key="NoteTextBox" TargetType="TextBox" BasedOn="{StaticResource PlainTextBox}">
            <Setter Property="Background" Value="{DynamicResource NoteSurfaceBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="False" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- Padding не дублируется на рамке: его применяет само поле (см. PlainTextBox). -->
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" Focusable="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Прозрачности из раздела 8: 40% покой, 70% активная карточка, 100% наведение на саму иконку.
            Место под иконки занято всегда, меняется только прозрачность — иначе карточка прыгает под курсором.
        -->
        <Style x:Key="CardIconButton" TargetType="Button">
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Opacity" Value="0.7" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Opacity" Value="0.7" />
                </DataTrigger>
                <!-- Последним: наведение на саму иконку перебивает состояние карточки. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Крестик появляется только на строке под курсором. Прозрачность задаётся стилем,
             а не на кнопке: локальное значение перебило бы триггеры (см. CardGlyph). -->
        <Style x:Key="SubtaskDeleteButton" TargetType="Button" BasedOn="{StaticResource CardIconButton}">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Строка чеклиста: своя подложка под выделение, у карточек она рисуется самой карточкой. -->
        <!-- Без BasedOn на неявный стиль: он объявлен ниже, а StaticResource смотрит только назад. -->
        <Style x:Key="SubtaskRow" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Пункт чеклиста — раздел 8. Чекбокс, текст, крестик по наведению. -->
        <DataTemplate x:Key="SubtaskTemplate">
            <Grid x:Name="SubRow">
                <!-- Появление и уход пункта — тем же приёмом, что у строки задачи. -->
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="SubRowScale" />
                </Grid.LayoutTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsDone}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"
                          RenderTransformOrigin="0.5,0.5">
                    <CheckBox.RenderTransform>
                        <!-- Чекбокс пункта мельче задачного: у чеклиста подчинённый вес — раздел 8. -->
                        <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                    </CheckBox.RenderTransform>
                </CheckBox>

                <TextBlock Grid.Column="1"
                           x:Name="SubtaskText"
                           Text="{Binding Title}"
                           ToolTip="{Binding Title}"
                           MouseLeftButtonDown="OnSubtaskClicked"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}" />

                <TextBox Grid.Column="1"
                         x:Name="SubtaskEditor"
                         Style="{StaticResource PlainTextBox}"
                         Padding="0"
                         FontSize="13"
                         MaxLength="500"
                         Visibility="Collapsed"
                         VerticalAlignment="Center"
                         IsVisibleChanged="OnSubtaskEditorVisibleChanged"
                         LostKeyboardFocus="OnSubtaskEditorLostFocus"
                         Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" />

                <Button Grid.Column="2"
                        Style="{StaticResource SubtaskDeleteButton}"
                        Command="{Binding DeleteCommand}"
                        ToolTip="Удалить пункт">
                    <TextBlock Text="✕" FontSize="11" />
                </Button>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="SubtaskText" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="SubtaskText" Property="Opacity" Value="0.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="SubtaskText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="SubtaskEditor" Property="Visibility" Value="Visible" />
                </DataTrigger>

                <!-- Добавленный пункт вырастает на месте, а не появляется рывком под курсором. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsNew}" Value="True" />
                        <Condition Binding="{Binding DataContext.AnimationsOn, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="SubRowScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 From="0" To="1" Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="SubRow"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.14" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>

                <DataTrigger Binding="{Binding IsLeaving}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="SubRowScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseIn" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="SubRow"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.14" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="SubRowScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1" Duration="0:0:0.12" />
                                <DoubleAnimation Storyboard.TargetName="SubRow"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Строка подсказки тегов: сам тег и справа число задач либо «создать». -->
        <DataTemplate x:Key="TagSuggestionTemplate">
            <Grid MouseLeftButtonUp="OnSuggestionClicked" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Hint}" FontSize="12"
                           Foreground="{DynamicResource MutedBrush}" />
            </Grid>
        </DataTemplate>

        <!-- Один вид подсказки на оба места, где пишут теги: поле ввода и правка заголовка. -->
        <Style x:Key="SuggestionList" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource NoteSurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MaxHeight" Value="152" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SubtaskRow}" />
            <Setter Property="ItemTemplate" Value="{StaticResource TagSuggestionTemplate}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <!-- «Отменить» в тосте: текстовая ссылка, а не кнопка с рамкой. -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontWeight="SemiBold" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка списка — только контейнер: вся отделка живёт на карточке, чтобы фон не накладывался дважды. -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <!-- Обе выравнивалки задаются явно: иначе ListBoxItem ищет их у родителя и сыплет
                 предупреждениями о привязке в момент, когда строку убирают из списка. -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

  <Grid x:Name="Root">
    <Border Padding="12">
        <Grid>
            <!-- Порядок строк расставляется кодом: при нижних углах он зеркалится (раздел 5). -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- MaxLength: жёсткий предел заголовка при наборе, раздел 7. Перелив вставки в заметку — в code-behind. -->
            <StackPanel x:Name="InputArea" Grid.Row="0">
                <TextBox x:Name="Input"
                         Style="{StaticResource PlainTextBox}"
                         Height="48"
                         FontSize="15"
                         MaxLength="500"
                         Tag="Новая задача"
                         SelectionChanged="OnInputSelectionChanged"
                         Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" />

                <!--
                    Подсказка тегов — раздел 7. Не Popup, а обычная строка разметки: окно и так
                    подстраивает высоту под содержимое, а Popup у окна поверх всех окон живёт
                    своей жизнью с фокусом и порядком отрисовки.
                -->
                <ListBox x:Name="TagSuggestions"
                         Style="{StaticResource SuggestionList}"
                         Margin="0,0,0,6"
                         ItemsSource="{Binding Suggestions}"
                         SelectedIndex="{Binding SuggestionIndex}"
                         Visibility="{Binding IsSuggestingBelowInput, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- Заготовка задачи: заметка и чеклист до её создания — раздел 7. Обе части
                 раскрываются по отдельности, поэтому у каждой своя обёртка со своим состоянием. -->
            <StackPanel x:Name="NoteArea" Grid.Row="1">
                <Border Style="{StaticResource Reveal}" Tag="{Binding IsNoteOpen}">
                    <Border.LayoutTransform>
                        <ScaleTransform />
                    </Border.LayoutTransform>
                    <TextBox x:Name="Note"
                             Style="{StaticResource NoteTextBox}"
                             Margin="0,0,0,6"
                             MinHeight="56"
                             MaxHeight="160"
                             LostKeyboardFocus="OnNoteLostFocus"
                             Text="{Binding NoteDraft, UpdateSourceTrigger=PropertyChanged}" />
                </Border>

                <!-- Чеклист будущей задачи. Вид тот же, что внутри карточки: это тот же чеклист,
                     просто у задачи, которой ещё нет. -->
                <Border Style="{StaticResource Reveal}" Tag="{Binding IsSubtaskDraftOpen}">
                    <Border.LayoutTransform>
                        <ScaleTransform />
                    </Border.LayoutTransform>
                    <StackPanel Margin="10,0,0,6">
                        <ListBox ItemsSource="{Binding SubtaskDraft}"
                                 ItemTemplate="{StaticResource SubtaskTemplate}"
                                 ItemContainerStyle="{StaticResource SubtaskRow}"
                                 Visibility="{Binding HasSubtaskDraft, Converter={StaticResource BoolToVisibility}}"
                                 MaxHeight="{Binding SubtaskListMaxHeight}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                        <TextBox x:Name="DraftSubtaskInput"
                                 Style="{StaticResource PlainTextBox}"
                                 Tag="+ подзадача"
                                 Padding="0"
                                 Margin="26,3,0,1"
                                 FontSize="13"
                                 MaxLength="500"
                                 LostKeyboardFocus="OnDraftSubtaskInputLostFocus"
                                 DataObject.Pasting="OnDraftSubtaskPasting" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border x:Name="Divider"
                    Grid.Row="2"
                    Height="1"
                    Margin="2,2,2,8"
                    Background="{DynamicResource DividerBrush}" />

            <!-- Одна прокручиваемая область на список, пустое состояние и блок выполненного:
                 потолок высоты считается одним числом, а не по каждому списку отдельно (раздел 5). -->
            <ScrollViewer x:Name="Scroll" Grid.Row="3" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="ScrollContent" PreviewMouseWheel="OnListMouseWheel">

            <ListBox x:Name="List"
                     ItemsSource="{Binding Tasks}"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AllowDrop="True"
                     SelectionChanged="OnListSelectionChanged"
                     PreviewMouseLeftButtonDown="OnListMouseDown"
                     PreviewMouseMove="OnListMouseMove"
                     DragOver="OnListDragOver"
                     DragLeave="OnListDragLeave"
                     Drop="OnListDrop"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource TextBrush}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid x:Name="Row">
                        <!--
                            Схлопывание при уходе — раздел 15. Именно LayoutTransform, а не
                            RenderTransform: сжиматься должна разметка, иначе на месте строки
                            останется дыра, и соседи доедут вверх рывком уже после удаления.
                        -->
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="RowScale" />
                        </Grid.LayoutTransform>

                        <!-- Место вставки при перетаскивании — раздел 9. -->
                        <Rectangle x:Name="DropAbove" Height="2" Margin="4,0" VerticalAlignment="Top"
                                   RadiusX="1" RadiusY="1" Visibility="Collapsed"
                                   Fill="{DynamicResource AccentBrush}" Panel.ZIndex="1" />
                        <Rectangle x:Name="DropBelow" Height="2" Margin="4,0" VerticalAlignment="Bottom"
                                   RadiusX="1" RadiusY="1" Visibility="Collapsed"
                                   Fill="{DynamicResource AccentBrush}" Panel.ZIndex="1" />

                        <!-- Рамка всегда на месте и прозрачна: фокусное кольцо не должно двигать текст. -->
                        <Border x:Name="Card"
                                MinHeight="44"
                                CornerRadius="10"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                Background="{DynamicResource CardBrush}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="CardShift" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--
                                    Слои состояния — раздел 15. Лежат под содержимым и поверх базового
                                    фона карточки; порядок в разметке задаёт, что видно выше при
                                    совпадении состояний. Фон самой карточки триггерами больше не
                                    подменяется: смена кисти скачком — это то, ради чего слои и заведены.
                                -->
                                <Border Grid.ColumnSpan="2"
                                        Style="{StaticResource StateLayer}"
                                        Background="{DynamicResource CardHoverBrush}"
                                        Tag="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <Border Grid.ColumnSpan="2"
                                        Style="{StaticResource StateLayer}"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        Tag="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <Border Grid.ColumnSpan="2"
                                        Style="{StaticResource StateLayer}"
                                        Background="{DynamicResource AccentHighlightBrush}"
                                        Tag="{Binding IsNew}" />

                                <!-- Полоска важности: видна постоянно у важных задач — раздел 8.
                                     Растёт сверху вниз тем же стилем, что и раскрывающиеся блоки. -->
                                <Rectangle Grid.Column="0"
                                           Width="3"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           Margin="0,8"
                                           HorizontalAlignment="Left"
                                           Fill="{DynamicResource AccentBrush}"
                                           Style="{StaticResource Reveal}"
                                           Tag="{Binding IsFlagged}">
                                    <Rectangle.LayoutTransform>
                                        <ScaleTransform />
                                    </Rectangle.LayoutTransform>
                                </Rectangle>

                                <Grid Grid.Column="1" Margin="5,8,8,8">
                                    <!-- Заголовок, теги, заметка, чеклист. Яруса с иконками у карточки нет:
                                         всё это видно само по себе, а строку он занимал всегда.
                                         Слева — колонка под корешок; место под него держится всегда,
                                         иначе заголовки карточек с содержимым и без разъезжались бы. -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--
                                        Корешок чеклиста — раздел 8. Идёт вдоль пунктов, напротив их
                                        чекбоксов, и сворачивает карточку по клику. У описания его нет:
                                        это корешок списка, а не всего содержимого. У свёрнутой карточки
                                        остаётся коротким штрихом у заголовка, иначе развернуть её мышью
                                        было бы нечем. Строка задаётся триггером ниже.
                                        Линия тонкая, а попадать по ней надо мышью, поэтому нажимается вся колонка.
                                    -->
                                    <Border x:Name="Spine"
                                            Grid.Column="0"
                                            Grid.Row="0"
                                            Grid.RowSpan="4"
                                            Background="Transparent"
                                            Cursor="Hand"
                                            Margin="0,1,0,1"
                                            MouseLeftButtonUp="OnSpineClicked"
                                            ToolTip="Свернуть или развернуть"
                                            Visibility="{Binding HasSubtasks, Converter={StaticResource BoolToVisibility}}">
                                        <Border x:Name="SpineLine"
                                                Width="2"
                                                CornerRadius="1"
                                                HorizontalAlignment="Left"
                                                Margin="1,0,0,0"
                                                Background="{DynamicResource SpineBrush}">
                                            <!-- Подсветка отдельным слоем: кисть корешка тоже заморожена. -->
                                            <Border Style="{StaticResource StateLayer}"
                                                    CornerRadius="1"
                                                    Background="{DynamicResource SpineHoverBrush}"
                                                    Tag="{Binding IsMouseOver, ElementName=Spine}" />
                                        </Border>
                                    </Border>

                                    <!-- Ярус 1: чекбокс, заголовок, важность -->
                                    <Grid Grid.Row="0" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Чекбокс всегда полной яркости: это главный элемент списка задач — раздел 8. -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsCompleted}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0" />

                                        <!--
                                            Лимит строк: у TextBlock в WPF нет MaxLines, поэтому потолок задаётся
                                            высотой в N строк при фиксированном LineHeight, а хвост режется многоточием.
                                            Подсказка висит всегда — определить факт обрезки WPF не даёт.
                                        -->
                                        <TextBlock Grid.Column="1"
                                                   x:Name="TitleText"
                                                   local:Highlighter.Text="{Binding Title}"
                                                   local:Highlighter.Query="{Binding DataContext.Draft, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   ToolTip="{Binding Title}"
                                                   MouseLeftButtonDown="OnTitleClicked"
                                                   FontSize="{Binding DataContext.TitleFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontFamily="{Binding DataContext.TitleFont, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   LineHeight="{Binding DataContext.TitleLineHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   VerticalAlignment="Center"
                                                   MaxHeight="{Binding DataContext.TitleMaxHeight, RelativeSource={RelativeSource AncestorType=Window}}" />

                                        <!--
                                            Правка на месте: Enter сохраняет, Esc откатывает — раздел 10.
                                            Под полем — та же подсказка тегов, что под полем ввода: теги
                                            дописывают и в уже живой задаче, и вспоминать их наизусть незачем.
                                        -->
                                        <StackPanel Grid.Column="1">
                                            <TextBox x:Name="TitleEditor"
                                                     Style="{StaticResource PlainTextBox}"
                                                     Padding="0"
                                                     FontSize="14"
                                                     MaxLength="500"
                                                     Visibility="Collapsed"
                                                     VerticalAlignment="Center"
                                                     IsVisibleChanged="OnTitleEditorVisibleChanged"
                                                     LostKeyboardFocus="OnTitleEditorLostFocus"
                                                     SelectionChanged="OnCardTitleSelectionChanged"
                                                     Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" />

                                            <ListBox x:Name="CardTagSuggestions"
                                                     Style="{StaticResource SuggestionList}"
                                                     Margin="0,6,0,2"
                                                     Visibility="Collapsed"
                                                     ItemsSource="{Binding DataContext.Suggestions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     SelectedIndex="{Binding DataContext.SuggestionIndex, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                x:Name="FlagButton"
                                                Style="{StaticResource CardIconButton}"
                                                Command="{Binding ToggleFlagCommand}"
                                                ToolTip="Важность"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="FlagGlyph" Text="!" FontSize="17" FontWeight="Bold" Margin="0,-2,0,0" />
                                        </Button>
                                    </Grid>

                                    <!-- Чипы тегов — раздел 8. Видны и у свёрнутой карточки: тег
                                         нужен, чтобы узнавать задачу в списке, а не только внутри неё. -->
                                    <ItemsControl Grid.Row="1"
                                                  Grid.Column="1"
                                                  ItemsSource="{Binding Tags}"
                                                  Margin="0,5,0,1"
                                                  Style="{StaticResource Reveal}"
                                                  Tag="{Binding HasTags}">
                                        <ItemsControl.LayoutTransform>
                                            <ScaleTransform />
                                        </ItemsControl.LayoutTransform>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Background}"
                                                        CornerRadius="4"
                                                        Padding="7,2"
                                                        Margin="0,0,6,3"
                                                        Cursor="Hand"
                                                        MouseLeftButtonUp="OnTagClicked"
                                                        ToolTip="Отобрать задачи с этим тегом">
                                                    <TextBlock Text="{Binding Label}"
                                                               Foreground="{Binding Foreground}"
                                                               FontSize="12" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Развёрнутая заметка. Пустая — это поле для её добавления. -->
                                    <Border Grid.Row="2"
                                            Grid.Column="1"
                                            Style="{StaticResource Reveal}"
                                            Tag="{Binding ShowNote}">
                                        <Border.LayoutTransform>
                                            <ScaleTransform />
                                        </Border.LayoutTransform>
                                        <TextBox x:Name="NoteEditor"
                                                 Style="{StaticResource NoteTextBox}"
                                                 Margin="0,6,0,0"
                                                 MinHeight="44"
                                                 MaxHeight="140"
                                                 LostKeyboardFocus="OnCardNoteLostFocus"
                                                 Text="{Binding Notes, UpdateSourceTrigger=LostFocus}" />
                                    </Border>

                                    <!--
                                        Чеклист под заметкой — раздел 8. Заметка отвечает «про что задача»,
                                        чеклист — «что в ней осталось». Потолок высоты кратен строке
                                        и задаётся настройкой: длинный список не должен растягивать
                                        одну задачу на всё окно, но и обрезанных пунктов быть не должно.
                                    -->
                                    <!-- Отступ слева: чеклист подчинён заголовку, а не стоит с ним вровень. -->
                                    <StackPanel Grid.Row="3"
                                                Grid.Column="1"
                                                Margin="0,6,0,0"
                                                Style="{StaticResource Reveal}"
                                                Tag="{Binding ShowChecklist}">
                                        <StackPanel.LayoutTransform>
                                            <ScaleTransform />
                                        </StackPanel.LayoutTransform>
                                        <ListBox x:Name="SubtaskList"
                                                 ItemsSource="{Binding Subtasks}"
                                                 ItemTemplate="{StaticResource SubtaskTemplate}"
                                                 ItemContainerStyle="{StaticResource SubtaskRow}"
                                                 Visibility="{Binding HasSubtasks, Converter={StaticResource BoolToVisibility}}"
                                                 MaxHeight="{Binding DataContext.SubtaskListMaxHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 HorizontalContentAlignment="Stretch"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                                        <!-- Строка добавления всегда последняя: набрал, Enter — и каретка осталась тут. -->
                                        <TextBox x:Name="SubtaskInput"
                                                 Style="{StaticResource PlainTextBox}"
                                                 Tag="+ подзадача"
                                                 Padding="0"
                                                 Margin="36,3,0,1"
                                                 FontSize="13"
                                                 MaxLength="500"
                                                 LostKeyboardFocus="OnSubtaskInputLostFocus"
                                                 DataObject.Pasting="OnSubtaskPasting" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                      </Grid>

                        <DataTemplate.Triggers>
                            <!-- Выполненная: приглушение и зачёркивание — раздел 15. -->
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.45" />
                                <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough" />
                            </DataTrigger>

                            <!-- Гаснет плавно: зачёркивание анимировать нечем, а приглушение можно.
                                 Возврат снимается FillBehavior, чтобы сеттер выше снова работал. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsCompleted}" Value="True" />
                                    <Condition Binding="{Binding DataContext.AnimationsOn, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.45" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard FillBehavior="Stop">
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>

                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="TitleEditor" Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <!-- Подсказка тегов принадлежит той карточке, которую сейчас правят. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsEditing}" Value="True" />
                                    <Condition Binding="{Binding DataContext.IsSuggesting, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="CardTagSuggestions" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>

                            <!-- Развёрнутая: линия стоит ровно вдоль пунктов чеклиста, не задевая описание. -->
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="Spine" Property="Grid.Row" Value="3" />
                                <Setter TargetName="Spine" Property="Grid.RowSpan" Value="1" />
                            </DataTrigger>

                            <!-- Корешок под курсором заметно светлеет: иначе непонятно, что по нему кликают. -->
                            <Trigger SourceName="Spine" Property="IsMouseOver" Value="True">
                                <Setter TargetName="SpineLine" Property="Width" Value="3" />
                            </Trigger>

                            <!-- Выделение: заливка акцентом лежит слоем, кольцу хватает подмены кисти. -->
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentRingBrush}" />
                            </DataTrigger>

                            <!-- Вставка строки, 180 мс — раздел 15. Играет только у новой карточки:
                                 вешать анимацию на появление контейнера нельзя, она бы дёргалась при фильтрации. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsNew}" Value="True" />
                                    <Condition Binding="{Binding DataContext.AnimationsOn, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="CardShift"
                                                             Storyboard.TargetProperty="Y"
                                                             From="-8" To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                            </MultiDataTrigger>

                            <!-- Важность — состояние, а не только кнопка: у отмеченной задачи знак виден всегда. -->
                            <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                <Setter TargetName="FlagGlyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="FlagButton" Property="Opacity" Value="1" />
                            </DataTrigger>

                            <!--
                                Перенос мышью: карточка гаснет, пока её тащат. FillBehavior="Stop"
                                на возврате обязателен — выполненная задача приглушена сеттером,
                                и анимация с HoldEnd навсегда перебила бы его непрозрачностью.
                            -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDragging}" Value="True" />
                                    <Condition Binding="{Binding DataContext.AnimationsOn, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.5" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard FillBehavior="Stop">
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>

                            <!--
                                Уход строки. Условия на AnimationsOn нет: признак ставится только
                                тогда, когда анимации включены, иначе строку убирают сразу.
                                Обратный ход нужен для Ctrl+Z: строку могут вернуть на полпути.
                            -->
                            <DataTrigger Binding="{Binding IsLeaving}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RowScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Row"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RowScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Row"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding DropIndicator}" Value="Above">
                                <Setter TargetName="DropAbove" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DropIndicator}" Value="Below">
                                <Setter TargetName="DropBelow" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Пустое состояние: раздел 9, и подсказка «Enter — создать» из раздела 7. -->
            <TextBlock x:Name="EmptyState"
                       Text="{Binding EmptyMessage}"
                       FontSize="13"
                       Margin="12,10,12,14"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"
                       Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVisibility}}">
                <!-- Только на появление: спрятать его Visibility успевает раньше любой анимации. -->
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsListEmpty}" Value="True" />
                                    <Condition Binding="{Binding AnimationsOn}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Блок «Выполнено сегодня» в конце списка, по умолчанию свёрнут — раздел 9. -->
            <StackPanel x:Name="CompletedBlock" Visibility="{Binding HasCompleted, Converter={StaticResource BoolToVisibility}}">
                <Border Background="Transparent"
                        Padding="8,8"
                        Cursor="Hand"
                        MouseLeftButtonUp="OnCompletedHeaderClicked">
                    <TextBlock Text="{Binding CompletedHeader}"
                               FontSize="13"
                               Foreground="{DynamicResource MutedBrush}" />
                </Border>

                <!-- Тот же шаблон карточки, что и у активного списка: держать вторую копию незачем. -->
                <ListBox x:Name="CompletedList"
                         ItemsSource="{Binding CompletedToday}"
                         SelectionChanged="OnListSelectionChanged"
                         ItemTemplate="{Binding ItemTemplate, ElementName=List}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextBrush}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Style="{StaticResource Reveal}"
                         Tag="{Binding IsCompletedExpanded}">
                    <ListBox.LayoutTransform>
                        <ScaleTransform />
                    </ListBox.LayoutTransform>
                </ListBox>
            </StackPanel>

              </StackPanel>
            </ScrollViewer>

            <!--
                Тост снизу окна — раздел 11. Системного уведомления быть не должно: окно и так поверх всех.
                Живёт строкой разметки, а не поверх списка: накрывать собой нижнюю карточку он не должен.
            -->
            <Border x:Name="Toast"
                    Grid.Row="4"
                    Margin="0,8,0,0"
                    Padding="12,8"
                    CornerRadius="8"
                    BorderThickness="1"
                    Background="{DynamicResource ToastBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    Tag="{Binding HasToast}">
                <!-- Выезжает снизу, а не возникает: окно как раз растёт на его высоту.
                     Сдвиг идёт по RenderTransform, потому что LayoutTransform занят раскрытием. -->
                <Border.LayoutTransform>
                    <ScaleTransform />
                </Border.LayoutTransform>
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Border.Style>
                    <!-- Проявление и уход берутся у Reveal, здесь остаётся только выезд. -->
                    <Style TargetType="Border" BasedOn="{StaticResource Reveal}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasToast}" Value="True" />
                                    <Condition Binding="{Binding AnimationsOn}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard FillBehavior="Stop">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="12" To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Toast}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" />
                    <Button Content="Отменить"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding UndoCommand}"
                            VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>

    <!-- Шпаргалка по F1 — раздел 10. Закрывается по F1 и по Esc. -->
    <Border Background="{DynamicResource ScrimBrush}"
            Padding="20"
            Visibility="{Binding IsHelpOpen, Converter={StaticResource BoolToVisibility}}">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsHelpOpen}" Value="True" />
                            <Condition Binding="{Binding AnimationsOn}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.14" />
                                </Storyboard>
                            </BeginStoryboard>
                        </MultiDataTrigger.EnterActions>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <!-- Содержимое подрастает вслед за затемнением — то же движение, что у появления окна. -->
            <StackPanel.RenderTransform>
                <ScaleTransform />
            </StackPanel.RenderTransform>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsHelpOpen}" Value="True" />
                                <Condition Binding="{Binding AnimationsOn}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="0.98" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="0.98" To="1" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Text="Горячие клавиши" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" />

            <TextBlock Text="Поле ввода" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,2" />
            <TextBlock Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Enter — создать · Ctrl+Enter — создать и закрыть · Tab — заметка, ещё раз — чеклист · ↓ — в список · Esc — скрыть окно" />

            <TextBlock Text="Список" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,2" />
            <TextBlock Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                       Text="↑↓ — навигация · Alt+↑↓ — переставить · Esc — назад в поле" />
            <TextBlock Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Space — выполнить · Enter — правка · Delete — удалить · → и ← — вглубь карточки и обратно · Ctrl+I — важность" />

            <TextBlock Text="Чеклист внутри задачи" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,2" />
            <TextBlock Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                       Text="Tab — вглубь карточки: заметка, затем пункты · Shift+Tab — обратно · то же стрелками → и ←" />
            <TextBlock Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Клавиши те же, что в списке: Space — выполнить · Enter — правка · Delete — удалить · Alt+↑↓ — переставить" />

            <TextBlock Text="Везде" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,2" />
            <TextBlock Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                       Text="Ctrl+Alt+Space — показать и скрыть окно · Ctrl+Z — отменить · Ctrl+Shift+Z — повторить · F1 — эта справка" />
        </StackPanel>
    </Border>
  </Grid>
</Window>
