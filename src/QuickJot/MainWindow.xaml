<Window x:Class="QuickJot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuickJot"
        Title="QuickJot"
        Width="560"
        MinWidth="360"
        MaxWidth="1200"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="Manual">

    <!-- AllowsTransparency НЕ используется: он убивает аппаратное ускорение и ломает Mica (раздел 5). -->
    <WindowChrome.WindowChrome>
        <!-- Ширина тянется мышью за края; высоту всё равно держит SizeToContent — раздел 5. -->
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 16x16. Свои контуры, а не глиф шрифта: не зависит от того, какой набор иконок стоит в системе. -->
        <Geometry x:Key="NoteGlyph">
            M2.5,2.5 H13.5 A2,2 0 0 1 15.5,4.5 V10.5 A2,2 0 0 1 13.5,12.5 H7 L3.9,15.2 A0.5,0.5 0 0 1 3,14.8 V12.5
            H2.5 A2,2 0 0 1 0.5,10.5 V4.5 A2,2 0 0 1 2.5,2.5 Z
        </Geometry>
        <Geometry x:Key="TrashGlyph">
            M6,1.5 H10 A1,1 0 0 1 11,2.5 V3 H14.2 V4.4 H1.8 V3 H5 V2.5 A1,1 0 0 1 6,1.5 Z
            M3.6,5.8 H12.4 L11.7,14 A1.4,1.4 0 0 1 10.3,15.3 H5.7 A1.4,1.4 0 0 1 4.3,14 Z
        </Geometry>

        <!--
            Поля без рамки: только каретка и placeholder (раздел 15). Стандартный шаблон Fluent
            рисует свою подложку и акцентное подчёркивание — на Mica это выглядит как дыра в окне.
        -->
        <Style x:Key="PlainTextBox" TargetType="TextBox">
            <!-- Ctrl+Z всегда уходит в стек операций, а не в отмену набора текста — раздел 11. -->
            <Setter Property="IsUndoEnabled" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionOpacity" Value="0.4" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <Grid>
                                <!--
                                    Padding отдан только тексту: WPF применяет его внутри поля сам,
                                    и если продублировать его на рамке, текст уезжает вправо вдвое.
                                    Placeholder получает тот же отступ и потому стоит ровно под кареткой.
                                -->
                                <TextBlock x:Name="Placeholder"
                                           Margin="{TemplateBinding Padding}"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />

                                <!-- Style={x:Null}: у ScrollViewer в теме Fluent свой отступ под жёлоб
                                     полосы прокрутки, из-за него текст начинался правее placeholder. -->
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Style="{x:Null}"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              Padding="0"
                                              Margin="0"
                                              HorizontalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заметка: вложенная поверхность, а не светлая коробка поверх тёмного окна. -->
        <Style x:Key="NoteTextBox" TargetType="TextBox" BasedOn="{StaticResource PlainTextBox}">
            <Setter Property="Background" Value="{DynamicResource NoteSurfaceBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="False" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- Padding не дублируется на рамке: его применяет само поле (см. PlainTextBox). -->
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" Focusable="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Цвет иконки задаётся стилем, а не прямо на элементе: локальное значение перебило бы
            триггеры шаблона, и облачко с заметкой никогда не получило бы акцентный цвет.
        -->
        <Style x:Key="CardGlyph" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{DynamicResource TextBrush}" />
        </Style>

        <!--
            Прозрачности из раздела 8: 40% покой, 70% активная карточка, 100% наведение на саму иконку.
            Место под иконки занято всегда, меняется только прозрачность — иначе карточка прыгает под курсором.
        -->
        <Style x:Key="CardIconButton" TargetType="Button">
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Opacity" Value="0.7" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Opacity" Value="0.7" />
                </DataTrigger>
                <!-- Последним: наведение на саму иконку перебивает состояние карточки. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- «Отменить» в тосте: текстовая ссылка, а не кнопка с рамкой. -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontWeight="SemiBold" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка списка — только контейнер: вся отделка живёт на карточке, чтобы фон не накладывался дважды. -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <!-- Обе выравнивалки задаются явно: иначе ListBoxItem ищет их у родителя и сыплет
                 предупреждениями о привязке в момент, когда строку убирают из списка. -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

  <Grid x:Name="Root">
    <Border Padding="12">
        <Grid>
            <!-- Порядок строк расставляется кодом: при нижних углах он зеркалится (раздел 5). -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- MaxLength: жёсткий предел заголовка при наборе, раздел 7. Перелив вставки в заметку — в code-behind. -->
            <Grid x:Name="InputArea" Grid.Row="0">
                <TextBox x:Name="Input"
                         Style="{StaticResource PlainTextBox}"
                         Height="48"
                         FontSize="15"
                         MaxLength="500"
                         Tag="Новая задача"
                         Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!-- Поле заметки: раскрывается по Tab, сворачивается только пустым — раздел 7. -->
            <TextBox x:Name="Note"
                     Grid.Row="1"
                     Style="{StaticResource NoteTextBox}"
                     Margin="0,0,0,6"
                     MinHeight="56"
                     MaxHeight="160"
                     Visibility="{Binding IsNoteOpen, Converter={StaticResource BoolToVisibility}}"
                     Text="{Binding NoteDraft, UpdateSourceTrigger=PropertyChanged}" />

            <Border x:Name="Divider"
                    Grid.Row="2"
                    Height="1"
                    Margin="2,2,2,8"
                    Background="{DynamicResource DividerBrush}" />

            <!-- Одна прокручиваемая область на список, пустое состояние и блок выполненного:
                 потолок высоты считается одним числом, а не по каждому списку отдельно (раздел 5). -->
            <ScrollViewer x:Name="Scroll" Grid.Row="3" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="ScrollContent">

            <ListBox x:Name="List"
                     ItemsSource="{Binding Tasks}"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="OnListMouseDown"
                     PreviewMouseMove="OnListMouseMove"
                     DragOver="OnListDragOver"
                     DragLeave="OnListDragLeave"
                     Drop="OnListDrop"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource TextBrush}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <!-- Место вставки при перетаскивании — раздел 9. -->
                        <Rectangle x:Name="DropAbove" Height="2" Margin="4,0" VerticalAlignment="Top"
                                   RadiusX="1" RadiusY="1" Visibility="Collapsed"
                                   Fill="{DynamicResource AccentBrush}" Panel.ZIndex="1" />
                        <Rectangle x:Name="DropBelow" Height="2" Margin="4,0" VerticalAlignment="Bottom"
                                   RadiusX="1" RadiusY="1" Visibility="Collapsed"
                                   Fill="{DynamicResource AccentBrush}" Panel.ZIndex="1" />

                        <!-- Рамка всегда на месте и прозрачна: фокусное кольцо не должно двигать текст. -->
                        <Border x:Name="Card"
                                MinHeight="64"
                                CornerRadius="10"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                Background="{DynamicResource CardBrush}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="CardShift" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Полоска важности: видна постоянно у важных задач — раздел 8. -->
                                <Rectangle Grid.Column="0"
                                           Width="3"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           Margin="0,8"
                                           HorizontalAlignment="Left"
                                           Fill="{DynamicResource AccentBrush}"
                                           Visibility="{Binding IsFlagged, Converter={StaticResource BoolToVisibility}}" />

                                <Grid Grid.Column="1" Margin="9,8,8,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Ярус 1: чекбокс, заголовок, важность -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Чекбокс всегда полной яркости: это главный элемент списка задач — раздел 8. -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsCompleted}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0" />

                                        <!--
                                            Лимит строк: у TextBlock в WPF нет MaxLines, поэтому потолок задаётся
                                            высотой в N строк при фиксированном LineHeight, а хвост режется многоточием.
                                            Подсказка висит всегда — определить факт обрезки WPF не даёт.
                                        -->
                                        <TextBlock Grid.Column="1"
                                                   x:Name="TitleText"
                                                   local:Highlighter.Text="{Binding Title}"
                                                   local:Highlighter.Query="{Binding DataContext.Draft, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   ToolTip="{Binding Title}"
                                                   MouseLeftButtonDown="OnTitleClicked"
                                                   FontSize="{Binding DataContext.TitleFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontFamily="{Binding DataContext.TitleFont, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   LineHeight="{Binding DataContext.TitleLineHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   VerticalAlignment="Center"
                                                   MaxHeight="{Binding DataContext.TitleMaxHeight, RelativeSource={RelativeSource AncestorType=Window}}" />

                                        <!-- Правка на месте: Enter сохраняет, Esc откатывает — раздел 10. -->
                                        <TextBox Grid.Column="1"
                                                 x:Name="TitleEditor"
                                                 Style="{StaticResource PlainTextBox}"
                                                 Padding="0"
                                                 FontSize="14"
                                                 MaxLength="500"
                                                 Visibility="Collapsed"
                                                 VerticalAlignment="Center"
                                                 IsVisibleChanged="OnTitleEditorVisibleChanged"
                                                 LostKeyboardFocus="OnTitleEditorLostFocus"
                                                 Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" />

                                        <Button Grid.Column="2"
                                                x:Name="FlagButton"
                                                Style="{StaticResource CardIconButton}"
                                                Command="{Binding ToggleFlagCommand}"
                                                ToolTip="Важность"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="FlagGlyph" Text="!" FontSize="17" FontWeight="Bold" Margin="0,-2,0,0" />
                                        </Button>
                                    </Grid>

                                    <!-- Ярус 2: облачко слева, мусорка справа -->
                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Style="{StaticResource CardIconButton}"
                                                Command="{Binding ToggleNoteCommand}"
                                                ToolTip="Заметка">
                                            <Path x:Name="NoteIcon"
                                                  Style="{StaticResource CardGlyph}"
                                                  Data="{StaticResource NoteGlyph}" />
                                        </Button>

                                        <Button Grid.Column="2"
                                                x:Name="DeleteButton"
                                                Style="{StaticResource CardIconButton}"
                                                Command="{Binding DeleteCommand}"
                                                ToolTip="Удалить">
                                            <Path x:Name="TrashIcon"
                                                  Style="{StaticResource CardGlyph}"
                                                  Data="{StaticResource TrashGlyph}" />
                                        </Button>
                                    </Grid>

                                    <!-- Развёрнутая заметка. Пустая — это поле для её добавления. -->
                                    <TextBox Grid.Row="2"
                                             x:Name="NoteEditor"
                                             Style="{StaticResource NoteTextBox}"
                                             Margin="0,6,0,0"
                                             MinHeight="44"
                                             MaxHeight="140"
                                             Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"
                                             Text="{Binding Notes, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                            </Grid>
                        </Border>
                      </Grid>

                        <DataTemplate.Triggers>
                            <!-- Выполненная: приглушение и зачёркивание — раздел 15. -->
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.45" />
                                <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="TitleEditor" Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            </DataTrigger>

                            <!-- Выделение: заливка акцентом 12% плюс фокусное кольцо — раздел 15. -->
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentRingBrush}" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentHighlightBrush}" />
                            </DataTrigger>

                            <!-- Вставка строки, 180 мс — раздел 15. Играет только у новой карточки:
                                 вешать анимацию на появление контейнера нельзя, она бы дёргалась при фильтрации. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsNew}" Value="True" />
                                    <Condition Binding="{Binding DataContext.AnimationsOn, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="CardShift"
                                                             Storyboard.TargetProperty="Y"
                                                             From="-8" To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                            </MultiDataTrigger>

                            <DataTrigger Binding="{Binding HasNotes}" Value="True">
                                <Setter TargetName="NoteIcon" Property="Fill" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>

                            <!-- Важность — состояние, а не только кнопка: у отмеченной задачи знак виден всегда. -->
                            <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                <Setter TargetName="FlagGlyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="FlagButton" Property="Opacity" Value="1" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding DropIndicator}" Value="Above">
                                <Setter TargetName="DropAbove" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DropIndicator}" Value="Below">
                                <Setter TargetName="DropBelow" Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <!-- Мусорка краснеет только при наведении на саму иконку — раздел 8. -->
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=DeleteButton}" Value="True">
                                <Setter TargetName="TrashIcon" Property="Fill" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Пустое состояние: раздел 9, и подсказка «Enter — создать» из раздела 7. -->
            <TextBlock x:Name="EmptyState"
                       Text="{Binding EmptyMessage}"
                       FontSize="13"
                       Margin="12,10,12,14"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"
                       Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVisibility}}" />

            <!-- Блок «Выполнено сегодня» в конце списка, по умолчанию свёрнут — раздел 9. -->
            <StackPanel x:Name="CompletedBlock" Visibility="{Binding HasCompleted, Converter={StaticResource BoolToVisibility}}">
                <Border Background="Transparent"
                        Padding="8,8"
                        Cursor="Hand"
                        MouseLeftButtonUp="OnCompletedHeaderClicked">
                    <TextBlock Text="{Binding CompletedHeader}"
                               FontSize="13"
                               Foreground="{DynamicResource MutedBrush}" />
                </Border>

                <!-- Тот же шаблон карточки, что и у активного списка: держать вторую копию незачем. -->
                <ListBox x:Name="CompletedList"
                         ItemsSource="{Binding CompletedToday}"
                         ItemTemplate="{Binding ItemTemplate, ElementName=List}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextBrush}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding IsCompletedExpanded, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

              </StackPanel>
            </ScrollViewer>

            <!--
                Тост снизу окна — раздел 11. Системного уведомления быть не должно: окно и так поверх всех.
                Живёт строкой разметки, а не поверх списка: накрывать собой нижнюю карточку он не должен.
            -->
            <Border x:Name="Toast"
                    Grid.Row="4"
                    Margin="0,8,0,0"
                    Padding="12,8"
                    CornerRadius="8"
                    BorderThickness="1"
                    Background="{DynamicResource ToastBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    Visibility="{Binding HasToast, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Toast}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" />
                    <Button Content="Отменить"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding UndoCommand}"
                            VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>

    <!-- Шпаргалка по F1 — раздел 10. Закрывается по F1 и по Esc. -->
    <Border Background="{DynamicResource ScrimBrush}"
            Padding="20"
            Visibility="{Binding IsHelpOpen, Converter={StaticResource BoolToVisibility}}">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Горячие клавиши" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" />

            <TextBlock Text="Поле ввода" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,2" />
            <TextBlock Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Enter — создать · Ctrl+Enter — создать и закрыть · Tab — заметка · ↓ — в список · Esc — скрыть окно" />

            <TextBlock Text="Список" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,2" />
