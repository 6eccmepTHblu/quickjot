<Window x:Class="QuickJot.TagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuickJot"
        Title="Теги QuickJot"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen">

    <!-- Та же оболочка, что у окна настроек: Mica, скруглённые углы, своя шапка (раздел 5). -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="44" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBoolToVisibilityConverter x:Key="NotBoolToVisibility" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>

        <!-- Кнопка без рамки: вся отделка строки — это сам чип, лишние рамки её ломают. -->
        <Style x:Key="Plain" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Plain}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Padding="16,12,16,16">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <TextBlock Text="Теги" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                <Button Content="✕" Style="{StaticResource Plain}" FontSize="15"
                        HorizontalAlignment="Right" Click="OnDoneClick"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                               Text="Тег существует, пока есть задача с ним. Цвет по умолчанию берётся из имени; выбранный здесь закрепляется за тегом. Удаление стирает тег из всех задач." />

                    <TextBlock Style="{StaticResource Hint}" Text="Тегов пока нет — добавьте их в задачу через «#»"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                    <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Сам тег ровно в том виде, в каком он на карточке. -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{Binding Background}" CornerRadius="4" Padding="7,2">
                                            <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}" FontSize="12" />
                                        </Border>
                                        <TextBlock Text="{Binding CountLabel}" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>

                                    <!-- Палитра: кружок на выбор, «А» — вернуть автоматический цвет. -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding IsConfirming, Converter={StaticResource NotBoolToVisibility}}">
                                        <ItemsControl ItemsSource="{Binding Swatches}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Ближайший ItemsControl — это сама палитра, а её
                                                         DataContext — строка тега: команда берётся оттуда. -->
                                                    <Button Command="{Binding DataContext.PickCommand,
                                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource Plain}"
                                                            Padding="2,0">
                                                        <Border x:Name="Dot" Width="16" Height="16" CornerRadius="8"
                                                                Background="{Binding Fill}"
                                                                BorderThickness="2"
                                                                BorderBrush="Transparent" />
                                                    </Button>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Dot" Property="BorderBrush"
                                                                    Value="{DynamicResource TextBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="авто" Style="{StaticResource Plain}" FontSize="12"
                                                Margin="6,0,0,0"
                                                Command="{Binding PickCommand}" />
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="✕" Style="{StaticResource Danger}" FontSize="13"
                                            Command="{Binding AskDeleteCommand}"
                                            ToolTip="Удалить тег из всех задач"
                                            Visibility="{Binding IsConfirming, Converter={StaticResource NotBoolToVisibility}}" />

                                    <!-- Подтверждение прямо в строке: отдельное окно ради одного вопроса — перебор. -->
                                    <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Удалить из всех задач?" Style="{StaticResource Hint}"
                                                   VerticalAlignment="Center" />
                                        <Button Content="Да" Style="{StaticResource Danger}" FontSize="13"
                                                Margin="10,0,0,0" Command="{Binding DeleteCommand}" />
                                        <Button Content="Нет" Style="{StaticResource Plain}" FontSize="13"
                                                Command="{Binding CancelDeleteCommand}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
